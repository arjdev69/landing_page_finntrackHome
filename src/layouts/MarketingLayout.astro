---
import Header from '@components/layout/Header.astro';
import Footer from '@components/layout/Footer.astro';
import AppLinkEnhancer from '@components/layout/AppLinkEnhancer.astro';
import AnalyticsInstrumentation from '@components/layout/AnalyticsInstrumentation.astro';
import SeoHead from '@components/seo/SeoHead.astro';
import { publicConfig } from '@config/public';
import { getRuntimeSiteConfig, siteConfig } from '@config/site';
import { resolveSeoMetadata, type PageSeoDefinition } from '@lib/seo/metadata';
import '@styles/global.css';

type Props = PageSeoDefinition;

const runtimeConfig = getRuntimeSiteConfig(Astro.url);
const metadata = resolveSeoMetadata(runtimeConfig.origin, Astro.props, runtimeConfig.environment);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-site-verification" content={siteConfig.googleSiteVerification} />
    <SeoHead {...metadata} />
    <slot name="head" />
  </head>
  <body class="bg-background text-foreground">
    <a
      class="absolute top-3 left-3 z-50 -translate-y-24 rounded-control bg-foreground px-4 py-3 font-semibold text-white transition-transform focus:translate-y-0 motion-reduce:transition-none"
      href="#main-content"
    >
      Pular para o conteúdo
    </a>
    <Header loginUrl={publicConfig.appLoginUrl} signupUrl={publicConfig.appSignupUrl} />
    <slot />
    <Footer loginUrl={publicConfig.appLoginUrl} />
    <AppLinkEnhancer />
    <AnalyticsInstrumentation />
  </body>
</html>
