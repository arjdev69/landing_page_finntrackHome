---
import AnalyticsInstrumentation from '@components/layout/AnalyticsInstrumentation.astro';
import AppLinkEnhancer from '@components/layout/AppLinkEnhancer.astro';
import Footer from '@components/layout/Footer.astro';
import Header from '@components/layout/Header.astro';
import VercelWebAnalytics from '@components/layout/VercelWebAnalytics.astro';
import SeoHead from '@components/seo/SeoHead.astro';
import { publicConfig } from '@config/public';
import { getRuntimeSiteConfig, siteConfig } from '@config/site';
import type { HomeContent } from '@i18n/content';
import type { Locale } from '@i18n/locales';
import { resolveSeoMetadata, type PageSeoDefinition } from '@lib/seo/metadata';
import '@styles/global.css';

type Props = PageSeoDefinition & {
  locale: Locale;
  content: HomeContent;
};

const { locale, content, ...seoDefinition } = Astro.props;
const runtimeConfig = getRuntimeSiteConfig(Astro.url);
const metadata = resolveSeoMetadata(runtimeConfig.origin, seoDefinition, runtimeConfig.environment);
const enableVercelWebAnalytics = runtimeConfig.environment === 'production';
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {
      siteConfig.googleSiteVerifications.map((verification) => (
        <meta name="google-site-verification" content={verification} />
      ))
    }
    <SeoHead
      {...metadata}
      openGraphLocale={content.seo.openGraphLocale}
      socialImageAlt={content.seo.socialImageAlt}
    />
    <slot name="head" />
  </head>
  <body class="bg-background text-foreground">
    <a
      class="absolute top-3 left-3 z-50 -translate-y-24 rounded-control bg-foreground px-4 py-3 font-semibold text-white transition-transform focus:translate-y-0 motion-reduce:transition-none"
      href="#main-content"
    >
      {content.shell.skipLink}
    </a>
    <Header
      locale={locale}
      shell={content.shell}
      content={content.header}
      loginUrl={publicConfig.appLoginUrl}
      signupUrl={publicConfig.appSignupUrl}
    />
    <slot />
    <Footer
      locale={locale}
      shell={content.shell}
      content={content.footer}
      loginUrl={publicConfig.appLoginUrl}
    />
    <AppLinkEnhancer />
    <AnalyticsInstrumentation />
    {enableVercelWebAnalytics && <VercelWebAnalytics />}
  </body>
</html>
