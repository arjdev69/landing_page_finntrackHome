---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import type { HomeContent } from '@i18n/content';
import type { Locale } from '@i18n/locales';
import { getHomeAnchor } from '@i18n/routes';

interface Props {
  locale: Locale;
  content: HomeContent['howItWorks'];
}

const { locale, content } = Astro.props;
---

<section
  id={getHomeAnchor(locale, 'howItWorks')}
  class="border-t border-border bg-surface py-16 sm:py-24"
  aria-labelledby="how-it-works-heading"
  tabindex="-1"
>
  <Container>
    <SectionHeading
      headingId="how-it-works-heading"
      eyebrow={content.eyebrow}
      title={content.title}
      description={content.description}
    />

    <ol class="mt-10 grid gap-5 lg:grid-cols-3">
      {
        content.steps.map((step, index) => (
          <li class="relative overflow-hidden rounded-card border border-border bg-background p-6 sm:p-8">
            <span class="text-sm font-semibold tracking-wide text-action uppercase">
              {content.stepLabel} {String(index + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-5 text-xl font-semibold tracking-tight text-foreground">{step.title}</h3>
            <p class="mt-3 text-base leading-7 text-muted">{step.description}</p>
            <span
              class="pointer-events-none absolute -right-3 -bottom-8 text-8xl font-semibold text-action/5"
              aria-hidden="true"
            >
              {index + 1}
            </span>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
