---
import { Image } from 'astro:assets';

import dashboardImage from '@/assets/product/dashboard-final-pt-br.png';
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { dashboardPreview } from '@config/product-assets';
---

<section
  id="demonstracao"
  class="border-t border-border py-16 sm:py-24"
  aria-labelledby="product-preview-heading"
  tabindex="-1"
  data-product-preview
>
  <Container>
    <div class="grid items-end gap-8 lg:grid-cols-[minmax(0,1fr)_auto]">
      <SectionHeading
        headingId="product-preview-heading"
        eyebrow="Demonstração do produto"
        title="Uma visão clara da sua carteira."
        description="KPIs do período, gráficos de receitas e despesas e a visão dos imóveis reunidos no mesmo painel."
      />
      <p
        class="w-fit rounded-full border border-border bg-surface px-4 py-2 text-sm font-medium text-muted"
      >
        Captura do produto · dados demonstrativos
      </p>
    </div>

    <figure class="mt-10">
      <div class="overflow-hidden rounded-card border border-border bg-surface shadow-card">
        <div class="flex items-center gap-2 border-b border-border px-4 py-3" aria-hidden="true">
          <span class="size-2.5 rounded-full bg-danger/70"></span>
          <span class="size-2.5 rounded-full bg-warning/80"></span>
          <span class="size-2.5 rounded-full bg-success/80"></span>
          <span class="ml-3 h-2.5 w-32 rounded-full bg-border sm:w-52"></span>
        </div>
        <Image
          src={dashboardImage}
          alt={dashboardPreview.altText}
          widths={[640, 960, 1440]}
          sizes="(max-width: 767px) 100vw, (max-width: 1199px) calc(100vw - 3rem), 1200px"
          format="webp"
          loading="lazy"
          decoding="async"
          class="block h-auto w-full"
        />
      </div>
      <figcaption class="mt-4 text-sm leading-6 text-muted">
        Dashboard real do ambiente demonstrativo, período de {dashboardPreview.capturedPeriod}; os
        dados exibidos são sintéticos.
      </figcaption>
    </figure>
  </Container>
</section>
