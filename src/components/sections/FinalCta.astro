---
import ButtonLink from '@components/ui/ButtonLink.astro';
import Container from '@components/ui/Container.astro';
import { publicConfig } from '@config/public';
import type { HomeContent } from '@i18n/content';

interface Props {
  content: HomeContent['finalCta'];
  signupLabel: string;
}

const { content, signupLabel } = Astro.props;
---

<section
  id="cta-final"
  class="border-t border-border py-16 sm:py-24"
  aria-labelledby="final-cta-heading"
>
  <Container>
    <div
      class="rounded-card bg-foreground px-6 py-12 text-center text-white shadow-card sm:px-10 sm:py-16"
    >
      <p class="text-sm font-semibold tracking-widest text-success uppercase">{content.eyebrow}</p>
      <h2
        id="final-cta-heading"
        class="mx-auto mt-3 max-w-3xl text-3xl font-semibold tracking-tight sm:text-4xl"
      >
        {content.title}
      </h2>
      <p class="mx-auto mt-5 max-w-reading text-base leading-7 text-slate-300 sm:text-lg">
        {content.description}
      </p>
      <ButtonLink
        href={publicConfig.appSignupUrl}
        class="mt-8 min-w-44"
        data-app-link
        data-destination-type="signup"
        data-cta-location="footer"
      >
        {signupLabel}
      </ButtonLink>
    </div>
  </Container>
</section>
