---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import type { HomeContent } from '@i18n/content';
import type { Locale } from '@i18n/locales';
import { getHomeAnchor } from '@i18n/routes';

interface Props {
  locale: Locale;
  content: HomeContent['benefits'];
}

const { locale, content } = Astro.props;
---

<section
  id={getHomeAnchor(locale, 'features')}
  class="border-t border-border py-16 sm:py-24"
  aria-labelledby="benefits-heading"
  tabindex="-1"
>
  <Container>
    <SectionHeading
      headingId="benefits-heading"
      eyebrow={content.eyebrow}
      title={content.title}
      description={content.description}
    />

    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        content.items.map((benefit) => (
          <li class="rounded-card border border-border bg-surface p-6 shadow-card sm:p-8">
            <span
              class="mb-6 flex size-12 items-center justify-center rounded-control bg-action/10 text-action"
              aria-hidden="true"
            >
              {benefit.icon === 'monthly-result' && (
                <svg
                  viewBox="0 0 24 24"
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M6 3v3m12-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Z" />
                  <path d="M8 16v-3m4 3v-5m4 5v-2" />
                </svg>
              )}
              {benefit.icon === 'accounts' && (
                <svg
                  viewBox="0 0 24 24"
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M7 3h10a2 2 0 0 1 2 2v16l-3-2-4 2-4-2-3 2V5a2 2 0 0 1 2-2Z" />
                  <path d="m8 11 2.5 2.5L16 8" />
                </svg>
              )}
              {benefit.icon === 'comparison' && (
                <svg
                  viewBox="0 0 24 24"
                  class="size-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                >
                  <path d="M4 20h16M7 17V9h3v8H7Zm7 0V4h3v13h-3Z" />
                </svg>
              )}
            </span>
            <h3 class="text-xl font-semibold tracking-tight text-foreground">{benefit.title}</h3>
            <p class="mt-3 text-base leading-7 text-muted">{benefit.description}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
