---
import Container from '@components/ui/Container.astro';
import SectionHeading from '@components/ui/SectionHeading.astro';
import { audienceContent } from '@config/home-content';
---

<section
  id="para-quem"
  class="border-t border-border py-16 sm:py-24"
  aria-labelledby="audience-heading"
  tabindex="-1"
>
  <Container>
    <SectionHeading
      headingId="audience-heading"
      eyebrow={audienceContent.eyebrow}
      title={audienceContent.title}
      description={audienceContent.description}
    />

    <ul class="mt-10 grid gap-5 md:grid-cols-3">
      {
        audienceContent.profiles.map((profile) => (
          <li class="rounded-card border border-border bg-surface p-6 shadow-card sm:p-8">
            <h3 class="text-xl font-semibold tracking-tight text-foreground">{profile.title}</h3>
            <p class="mt-3 text-base leading-7 text-muted">{profile.description}</p>
          </li>
        ))
      }
    </ul>

    <p
      class="mt-8 max-w-reading rounded-card border border-border-strong bg-background p-5 text-base leading-7 text-foreground sm:p-6"
    >
      <strong class="font-semibold">Limite de escopo:</strong>
      {audienceContent.limitation}
    </p>
  </Container>
</section>
