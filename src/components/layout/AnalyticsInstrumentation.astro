<script>
  import { getAnalyticsClient } from '@lib/analytics/client';
  import type { CtaLocation, DestinationType } from '@lib/analytics/contract';
  import { createPageAnalytics } from '@lib/analytics/page';

  try {
    const analytics = createPageAnalytics(getAnalyticsClient(), {
      url: new URL(window.location.href),
      referrer: document.referrer,
      viewportWidth: window.innerWidth,
    });

    analytics.viewLanding();

    document.querySelectorAll<HTMLAnchorElement>('a[data-app-link]').forEach((link) => {
      link.addEventListener('click', () => {
        const destinationType = link.dataset.destinationType as DestinationType | undefined;
        const ctaLocation = link.dataset.ctaLocation as CtaLocation | undefined;

        if (destinationType && ctaLocation) {
          analytics.clickAppLink({ destinationType, ctaLocation });
        }
      });
    });

    document.querySelectorAll<HTMLAnchorElement>('a[data-secondary-cta]').forEach((link) => {
      link.addEventListener('click', () => {
        const ctaLocation = link.dataset.ctaLocation as CtaLocation | undefined;
        if (ctaLocation) analytics.clickSecondary(ctaLocation);
      });
    });

    document.querySelectorAll<HTMLDetailsElement>('details[data-faq-id]').forEach((item) => {
      item.addEventListener('toggle', () => {
        if (item.open && item.dataset.faqId) analytics.openFaq(item.dataset.faqId);
      });
    });

    const productPreview = document.querySelector<HTMLElement>('[data-product-preview]');

    if (productPreview && 'IntersectionObserver' in window) {
      let visibilityTimer: number | undefined;
      const observer = new IntersectionObserver(
        (entries) => {
          const entry = entries[0];

          if (entry?.isIntersecting && entry.intersectionRatio >= 0.5) {
            visibilityTimer ??= window.setTimeout(() => {
              analytics.viewProductPreview();
              observer.disconnect();
            }, 1_000);
          } else if (visibilityTimer !== undefined) {
            window.clearTimeout(visibilityTimer);
            visibilityTimer = undefined;
          }
        },
        { threshold: [0, 0.5] },
      );

      observer.observe(productPreview);
    }
  } catch {
    // Conteúdo e CTAs continuam funcionais quando analytics falha.
  }
</script>
