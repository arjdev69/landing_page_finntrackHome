---
import type { HomeContent } from '@i18n/content';
import { localeConfig, supportedLocales, type Locale } from '@i18n/locales';

interface Props {
  locale: Locale;
  shell: HomeContent['shell'];
}

const { locale, shell } = Astro.props;
---

<div
  class="inline-flex min-h-11 items-center gap-0.5 rounded-full border border-border bg-background p-1"
  role="group"
  aria-label={shell.languageSelectorLabel}
  data-locale-switcher
>
  {
    supportedLocales.map((targetLocale) => {
      const target = localeConfig[targetLocale];
      const isCurrent = targetLocale === locale;
      const accessibleLabel = isCurrent
        ? `${target.accessibleName} — ${shell.currentLanguageLabel}`
        : `${shell.switchLanguageLabel} ${target.accessibleName}`;

      return (
        <a
          class:list={[
            'inline-flex min-h-9 min-w-11 items-center justify-center gap-2 rounded-full px-2.5 text-sm transition-colors',
            isCurrent
              ? 'bg-surface font-semibold text-foreground shadow-sm ring-1 ring-border'
              : 'font-medium text-muted hover:bg-surface hover:text-foreground',
          ]}
          href={target.path}
          hreflang={targetLocale}
          lang={targetLocale}
          aria-label={accessibleLabel}
          aria-current={isCurrent ? 'page' : undefined}
        >
          {targetLocale === 'pt-BR' ? (
            <svg
              class="h-3.5 w-5 shrink-0 rounded-[2px] shadow-[0_0_0_1px_rgb(15_23_42_/_0.08)]"
              viewBox="0 0 20 14"
              aria-hidden="true"
              data-locale-flag="pt-BR"
            >
              <rect width="20" height="14" rx="1.5" fill="#229E45" />
              <path d="M10 2.1 17.1 7 10 11.9 2.9 7 10 2.1Z" fill="#F8E34B" />
              <circle cx="10" cy="7" r="2.75" fill="#2B49A3" />
              <path
                d="M7.55 6.45c1.8-.55 3.55-.32 5.02.62"
                fill="none"
                stroke="#fff"
                stroke-width=".6"
              />
            </svg>
          ) : (
            <svg
              class="h-3.5 w-5 shrink-0 rounded-[2px] shadow-[0_0_0_1px_rgb(15_23_42_/_0.08)]"
              viewBox="0 0 20 14"
              aria-hidden="true"
              data-locale-flag="en-US"
            >
              <rect width="20" height="14" rx="1.5" fill="#fff" />
              <path d="M0 0h20v2H0zm0 4h20v2H0zm0 4h20v2H0zm0 4h20v2H0z" fill="#D8393E" />
              <path d="M0 0h8.7v7.5H0z" fill="#31468A" />
              <path
                d="m1.3 1 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04L1.3 1Zm2.05 0 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04L3.35 1ZM5.4 1l.18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04L5.4 1Zm2.05 0 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04L7.45 1ZM2.3 3.05l.18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04.18-.42Zm2.05 0 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04.18-.42Zm2.05 0 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04.18-.42ZM1.3 5.1l.18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04.18-.42Zm2.05 0 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04.18-.42Zm2.05 0 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04.18-.42Zm2.05 0 .18.42.45.04-.35.3.1.44-.38-.24-.38.24.1-.44-.35-.3.45-.04.18-.42Z"
                fill="#fff"
              />
            </svg>
          )}
          <span>{target.visualLabel}</span>
        </a>
      );
    })
  }
</div>
