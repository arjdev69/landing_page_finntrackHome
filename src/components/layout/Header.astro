---
import LocaleSwitcher from '@components/layout/LocaleSwitcher.astro';
import MobileNavigation from '@components/layout/MobileNavigation.astro';
import ButtonLink from '@components/ui/ButtonLink.astro';
import Container from '@components/ui/Container.astro';
import type { NavigationItem } from '@config/navigation';
import type { HomeContent } from '@i18n/content';
import type { Locale } from '@i18n/locales';
import { getHomeAnchorHref, getLocalizedRoute } from '@i18n/routes';

interface Props {
  locale: Locale;
  shell: HomeContent['shell'];
  content: HomeContent['header'];
  loginUrl: string;
  signupUrl: string;
}

const { locale, shell, content, loginUrl, signupUrl } = Astro.props;
const homeUrl = getLocalizedRoute('home', locale);
const primaryNavigation: readonly NavigationItem[] = content.navigation.map((item) => ({
  label: item.label,
  href: getHomeAnchorHref(locale, item.anchor),
}));
---

<header class="border-b border-border bg-surface" data-site-header>
  <Container>
    <div class="flex min-h-16 items-center justify-between gap-4 py-2">
      <a
        class="inline-flex min-h-11 items-center rounded-control"
        href={homeUrl}
        aria-label={shell.homeLinkLabel}
      >
        <img src="/brand/finntrack-home-logo.svg" alt="" width="160" height="32" decoding="async" />
      </a>

      <nav class="hidden lg:block" aria-label={shell.primaryNavigationLabel}>
        <ul class="flex items-center gap-1">
          {
            primaryNavigation.map((item) => (
              <li>
                <a
                  class="inline-flex min-h-11 items-center rounded-control px-3 py-2 text-sm font-medium text-foreground hover:bg-background"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="hidden items-center gap-2 lg:flex">
        <LocaleSwitcher locale={locale} shell={shell} />
        <a
          class="inline-flex min-h-11 items-center rounded-control px-3 py-2 text-sm font-semibold text-foreground hover:bg-background"
          href={loginUrl}
          data-app-link
          data-destination-type="login"
          data-cta-location="header"
        >
          {content.loginLabel}
        </a>
        <ButtonLink
          href={signupUrl}
          size="compact"
          data-app-link
          data-destination-type="signup"
          data-cta-location="header"
        >
          {content.signupLabel}
        </ButtonLink>
      </div>

      <MobileNavigation
        locale={locale}
        shell={shell}
        items={primaryNavigation}
        loginLabel={content.loginLabel}
        loginUrl={loginUrl}
        signupLabel={content.signupLabel}
        signupUrl={signupUrl}
      />
    </div>
  </Container>
</header>
