---
import Container from '@components/ui/Container.astro';
import { footerContent } from '@config/home-content';
import { siteConfig } from '@config/site';

interface Props {
  loginUrl: string;
}

const { loginUrl } = Astro.props;
const currentYear = new Date().getUTCFullYear();
const supportHref = `mailto:${footerContent.supportEmail}`;
---

<footer class="border-t border-border bg-surface py-10" aria-label="Rodapé">
  <Container>
    <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-start">
      <div class="max-w-md">
        <a
          class="inline-flex min-h-11 items-center rounded-control font-semibold text-foreground"
          href="/"
        >
          <span class="text-action">FinnTrack</span>&nbsp;Home
        </a>
        <p class="mt-3 text-sm leading-6 text-muted">{footerContent.description}</p>
      </div>

      <nav aria-label="Navegação do rodapé">
        <ul class="grid gap-1 sm:grid-cols-2 md:grid-cols-4">
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-control px-3 py-2 text-sm font-medium text-foreground hover:bg-background"
              href={loginUrl}
              data-app-link
              data-destination-type="login"
              data-cta-location="footer">Entrar</a
            >
          </li>
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-control px-3 py-2 text-sm font-medium text-foreground hover:bg-background"
              href="/privacidade">Privacidade</a
            >
          </li>
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-control px-3 py-2 text-sm font-medium text-foreground hover:bg-background"
              href="/termos">Termos</a
            >
          </li>
          <li>
            <a
              class="inline-flex min-h-11 items-center rounded-control px-3 py-2 text-sm font-medium text-foreground hover:bg-background"
              href={supportHref}>Suporte</a
            >
          </li>
        </ul>
      </nav>
    </div>

    <div class="mt-8 border-t border-border pt-6 text-sm text-muted">
      <p>© {currentYear} {siteConfig.name}. Todos os direitos reservados.</p>
      <p class="mt-2">
        Suporte: <a
          class="rounded-sm font-medium text-foreground underline decoration-border-strong underline-offset-4"
          href={supportHref}>{footerContent.supportEmail}</a
        >
      </p>
    </div>
  </Container>
</footer>
