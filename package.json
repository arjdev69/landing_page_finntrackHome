{
  "name": "finntrack-home-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:env && astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"vendor/**/*.{cjs,ts,json}\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"scripts/**/*.mjs\" \"test/**/*.mjs\" \"vendor/**/*.{cjs,ts,json}\" \"*.{js,mjs,json}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "node --experimental-strip-types --test \"test/*.test.mjs\"",
    "test:a11y": "playwright test test/e2e/accessibility.e2e.mjs",
    "test:compat": "playwright test --config playwright.compat.config.mjs",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report artifacts/playwright/html",
    "test:analytics:production": "node scripts/validate-production-analytics.mjs",
    "test:perf": "node scripts/run-performance-audit.mjs",
    "test:perf:baseline": "node scripts/run-performance-audit.mjs --baseline",
    "test:security": "node scripts/validate-security-headers.mjs && npm audit --audit-level=moderate",
    "test:watch": "node --experimental-strip-types --test --watch",
    "validate:env": "node --experimental-strip-types scripts/validate-env.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.1.3",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "~1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "lighthouse": "^13.4.1",
    "minimatch": "file:vendor/minimatch-compat",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "minimatch": "$minimatch"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@vercel/analytics": "^2.0.1"
  }
}
