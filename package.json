{
  "name": "finntrack-home-landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"test/**/*.mjs\" \"*.{js,mjs,json}\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"test/**/*.mjs\" \"*.{js,mjs,json}\"",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "test": "node --test",
    "test:watch": "node --test --watch"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.39.2",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.9",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "~1.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0"
  }
}
